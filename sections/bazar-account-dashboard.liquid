{{ 'bazar-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bazar-account.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign account_title_id = 'BazarAccountTitle-' | append: section.id
  assign account_sidebar_id = 'BazarAccountSidebar-' | append: section.id
%}

<section
  class="bazar-account-module"
  aria-labelledby="{{ account_title_id }}"
  data-bazar-account-module
  data-bazar-account-root-url="/profile"
  data-bazar-account-logout-url="{{ routes.account_logout_url }}"
>
  <div class="bazar-account-module__container">
    {% if customer %}
      {% render 'bazar-account-provider-data' %}

      <button
        class="bazar-account-mobile-toggle"
        type="button"
        data-account-sidebar-open
        aria-controls="{{ account_sidebar_id }}"
        aria-expanded="false"
      >
        <span aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"/>
          </svg>
        </span>
        Меню акаунта
      </button>

      <div class="bazar-account-shell">
        {% render 'bazar-account-sidebar',
          sidebar_id: account_sidebar_id,
          title_id: account_title_id
        %}

        <main class="bazar-account-content" data-account-content tabindex="-1">
          <div class="bazar-account-loading" role="status" aria-live="polite">
            <span class="bazar-account-skeleton bazar-account-skeleton--title"></span>
            <span class="bazar-account-skeleton bazar-account-skeleton--line"></span>
            <div class="bazar-account-skeleton-grid">
              <span class="bazar-account-skeleton bazar-account-skeleton--card"></span>
              <span class="bazar-account-skeleton bazar-account-skeleton--card"></span>
              <span class="bazar-account-skeleton bazar-account-skeleton--card"></span>
            </div>
          </div>
        </main>
      </div>

      <div class="bazar-account-drawer-backdrop" data-account-sidebar-backdrop data-account-sidebar-close hidden></div>
    {% else %}
      <div class="bazar-account-guest" aria-labelledby="{{ account_title_id }}">
        <span class="bazar-account-guest__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="M4.5 21a7.5 7.5 0 0 1 15 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>
          </svg>
        </span>
        <p class="bazar-account-guest__eyebrow">Потрібен вхід</p>
        <h1 id="{{ account_title_id }}">Увійдіть до акаунта</h1>
        <p>Особистий кабінет BAZAR доступний після входу.</p>
        <button
          class="bazar-account-button bazar-account-button--primary"
          type="button"
          data-bazar-auth-open
          data-bazar-account-url="/profile"
        >
          Увійти
        </button>
      </div>

      <span
        data-bazar-auth-auto-open="BazarHeaderAuthModal"
        hidden
      ></span>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "BAZAR Акаунт",
  "enabled_on": {
    "templates": ["customers/account", "page"]
  },
  "settings": [],
  "presets": [
    {
      "name": "BAZAR Акаунт"
    }
  ]
}
{% endschema %}

{% liquid
  assign category_menu = section.settings.menu
  assign link_count = 0
  if category_menu != blank
    assign link_count = category_menu.links.size
  endif
  assign show_placeholders = false
  if link_count == 0 and request.design_mode
    assign show_placeholders = true
  elsif link_count == 0 and request.visual_preview_mode
    assign show_placeholders = true
  endif
%}

{% if link_count > 0 or show_placeholders %}
  <section class="bazar-home bazar-home__section">
    <div class="bazar-container">
      <div class="bazar-home__header">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="bazar-home__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          <h2 class="bazar-home__title">{{ section.settings.heading }}</h2>
        </div>
      </div>

      <div class="bazar-category-grid">
        {% if link_count > 0 %}
          {% for link in category_menu.links limit: section.settings.max_items %}
            <a
              class="bazar-category-card"
              href="{{ link.url }}"
            >
              <span class="bazar-category-card__icon">{{ link.title | slice: 0 | upcase }}</span>
              <span class="bazar-category-card__title">{{ link.title }}</span>
            </a>
          {% endfor %}
        {% else %}
          {% for index in (1..6) %}
            <div class="bazar-category-card" aria-hidden="true">
              <span class="bazar-category-card__icon"></span>
              <span class="bazar-product-card__placeholder-line"></span>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "BAZAR Category blocks",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Категорії"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Популярні категорії"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum items",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "BAZAR Category blocks"
    }
  ]
}
{% endschema %}

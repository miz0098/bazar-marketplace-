{% doc %}
  BAZAR Header v1.2 action group.

  Only renders the approved desktop actions: favorites, profile, and cart.
{% enddoc %}

{% liquid
  assign favorites_url = '/profile/wishlist'
  assign profile_url = '/profile'
  assign account_url = profile_url
  assign account_label = 'Увійти'

  if customer != blank
    assign account_label = 'Профіль'
  endif
%}

<div
  class="bazar-header-actions"
  aria-label="Дії користувача"
>
  <a
    href="{{ favorites_url }}"
    class="bazar-header-action bazar-header-action--favorites"
    aria-label="Обране"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="BazarFavoritesModal"
    data-bazar-favorites-open
  >
    <span
      class="bazar-header-action__icon"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        focusable="false"
      >
        <path
          d="M20.2 5.1a5.4 5.4 0 0 0-7.6 0l-.6.6-.6-.6a5.4 5.4 0 0 0-7.6 7.6l.6.6L12 20.9l7.6-7.6.6-.6a5.4 5.4 0 0 0 0-7.6Z"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
        />
      </svg>
    </span>
    <span class="bazar-header-action__label">Обране</span>
  </a>

  {% if customer %}
    <a
      href="{{ profile_url }}"
      class="bazar-header-action"
      aria-label="Профіль"
    >
      <span
        class="bazar-header-action__icon"
        aria-hidden="true"
      >
        {% render 'bazar-auth-icon', name: 'user' %}
      </span>
      <span class="bazar-header-action__label">{{ account_label }}</span>
    </a>
  {% else %}
    <a
      href="{{ account_url }}"
      class="bazar-header-action"
      aria-label="Увійти"
      data-bazar-auth-open
      data-bazar-account-url="{{ profile_url }}"
    >
      <span
        class="bazar-header-action__icon"
        aria-hidden="true"
      >
        {% render 'bazar-auth-icon', name: 'user' %}
      </span>
      <span class="bazar-header-action__label">Увійти</span>
    </a>
  {% endif %}

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    <button
      class="bazar-header-action bazar-header-action--cart"
      type="button"
      on:click="#cart-drawer/toggle"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="cart-drawer"
      aria-label="Кошик{% if cart.item_count > 0 %}: {{ cart.item_count }}{% endif %}"
    >
      <span
        class="bazar-header-action__icon"
        aria-hidden="true"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}
      </span>
      <span class="bazar-header-action__label">Кошик</span>
      {% if cart.item_count > 0 %}
        <span class="bazar-header-action__badge">{{ cart.item_count }}</span>
      {% endif %}
    </button>
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="bazar-header-action bazar-header-action--cart"
      aria-label="Кошик{% if cart.item_count > 0 %}: {{ cart.item_count }}{% endif %}"
    >
      <span
        class="bazar-header-action__icon"
        aria-hidden="true"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}
      </span>
      <span class="bazar-header-action__label">Кошик</span>
      {% if cart.item_count > 0 %}
        <span class="bazar-header-action__badge">{{ cart.item_count }}</span>
      {% endif %}
    </a>
  {% endif %}
</div>

{% render 'bazar-wishlist-data' %}
{% render 'bazar-favorites-modal' %}

{% if customer == blank %}
  {% render 'bazar-auth-modal',
    id: 'BazarHeaderAuthModal',
    surface: 'modal',
    initial_flow: 'login'
  %}
{% endif %}

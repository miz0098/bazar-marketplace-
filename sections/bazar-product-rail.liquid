{% liquid
  assign selected_products = section.settings.product_list
  assign selected_collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign has_products = false

  if selected_products != blank and selected_products.count > 0
    assign has_products = true
  elsif selected_collection != blank and selected_collection.products.size > 0
    assign has_products = true
  endif
%}

<section class="bazar-home bazar-home__section{% if section.settings.background_style == 'soft' %} bazar-home__section--soft{% endif %}">
  <div class="bazar-container">
    <div class="bazar-home__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="bazar-home__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="bazar-home__title">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <p class="bazar-home__text">{{ section.settings.text }}</p>
        {% endif %}
      </div>
      {% if selected_collection != blank and section.settings.show_view_all %}
        <a
          class="bazar-button bazar-button--secondary"
          href="{{ selected_collection.url }}"
        >
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>

    {% if has_products %}
      <div class="bazar-product-rail__grid">
        {% if selected_products != blank and selected_products.count > 0 %}
          {% for product in selected_products limit: products_to_show %}
            {% render 'bazar-product-card', product: product, show_vendor: section.settings.show_vendor %}
          {% endfor %}
        {% elsif selected_collection != blank %}
          {% for product in selected_collection.products limit: products_to_show %}
            {% render 'bazar-product-card', product: product, show_vendor: section.settings.show_vendor %}
          {% endfor %}
        {% endif %}
      </div>
    {% else %}
      <div class="bazar-product-rail__empty">
        <p>Товари для цієї добірки ще не обрано.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "BAZAR Товарна добірка",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаголовок"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заголовок",
      "default": "Товари"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Текст"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Обрані товари",
      "limit": 12
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Колекція як запасне джерело"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Кількість товарів",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Показувати продавця",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Показувати посилання на всі товари",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Текст посилання на всі товари",
      "default": "Дивитися всі"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Фон",
      "options": [
        {
          "value": "default",
          "label": "Звичайний"
        },
        {
          "value": "soft",
          "label": "М’який"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "BAZAR Товарна добірка"
    }
  ]
}
{% endschema %}

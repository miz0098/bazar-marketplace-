NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=5000

# Set locally via environment or ignored .env.local; never commit URLs containing passwords.
# DATABASE_URL and MIGRATION_DATABASE_URL intentionally have no checked-in credentials.
DATABASE_SSL=disable
DATABASE_TIMEOUT_MS=1500

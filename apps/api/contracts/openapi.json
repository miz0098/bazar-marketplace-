{
  "openapi": "3.1.0",
  "info": {
    "title": "BAZAR API Foundation",
    "version": "1.0.0",
    "description": "Foundation HTTP routes only. PostgreSQL schema readiness is checked, while authentication, business operations and provider integrations remain unavailable."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000",
      "description": "Local development only; no deployment is implied"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "JSON envelope; HEAD has matching headers and no body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "JSON envelope; HEAD has matching headers and no body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "JSON envelope; HEAD has matching headers and no body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "JSON envelope; HEAD has matching headers and no body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "getHealthHeaders",
        "responses": {
          "200": {
            "description": "Same status and headers as GET, without a response body"
          },
          "default": {
            "description": "Same error status/headers as GET, without a body"
          }
        }
      },
      "options": {
        "operationId": "getHealthPreflight",
        "description": "Requires an exact allow-listed Origin and Access-Control-Request-Method GET or HEAD. Only Content-Type is allowed in requested headers. No credentials.",
        "responses": {
          "204": {
            "description": "Validated CORS preflight; no response body"
          },
          "default": {
            "description": "JSON envelope; HEAD has matching headers and no body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "JSON envelope; HEAD has matching headers and no body",
            "content": {
              "application/json": {

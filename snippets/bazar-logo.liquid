{% doc %}
  BAZAR logo mark with blue shopping-bag icon and BAZAR wordmark.

  @param {string} [class] - Additional class name.
{% enddoc %}

<a
  href="{{ routes.root_url }}"
  class="bazar-logo{% if class != blank %} {{ class }}{% endif %}"
  aria-label="BAZAR"
>
  <span
    class="bazar-logo__icon"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 40 40"
      focusable="false"
    >
      <path
        d="M11.2 14.2h17.6l1.8 18.1H9.4l1.8-18.1Z"
        fill="currentColor"
      />
      <path
        d="M15.2 15.1v-2.3a4.8 4.8 0 0 1 9.6 0v2.3"
        fill="none"
        stroke="#fff"
        stroke-linecap="round"
        stroke-width="2.4"
      />
      <text
        x="20"
        y="27.5"
        fill="#fff"
        dominant-baseline="middle"
        font-family="Inter, Arial, sans-serif"
        font-size="14"
        font-weight="900"
        text-anchor="middle"
      >B</text>
    </svg>
  </span>
  <span class="bazar-logo__text">BAZAR</span>
</a>

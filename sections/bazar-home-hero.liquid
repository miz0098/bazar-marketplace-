{% comment %}Selective structural recovery from bazar-home-hero@105d10f; synthetic artwork, claims and autoplay removed.{% endcomment %}
{% assign hero_alt = section.settings.image_alt | default: section.settings.image.alt | default: 'Головний банер BAZAR' %}
{% if section.settings.image != blank %}
  <div class="bazar-ui bazar-home">
    <div class="bazar-container bazar-home-hero{% if section.settings.menu.links.size > 0 %} bazar-home-hero--with-menu{% endif %}">
      {% if section.settings.menu.links.size > 0 %}<nav class="bazar-home-catalog" aria-label="Категорії товарів">{% render 'bazar-catalog-links', menu: section.settings.menu %}</nav>{% endif %}
      <div class="bazar-home-hero__media">
        {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
          <picture>
            {% if section.settings.mobile_image != blank %}<source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}
            {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 1024px) 80vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt, class: 'bazar-home-hero__image' }}
          </picture>
        {% if section.settings.link != blank %}</a>{% endif %}
      </div>
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="bazar-ui bazar-container bazar-editor-note">BAZAR: додайте погоджений банер та його опис. Банер прихований від покупців, доки зображення відсутнє.</div>
{% endif %}
{% schema %}
{
  "name": "BAZAR — головний банер",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Оберіть оригінальний погоджений банер. Без зображення блок не показується покупцям. Тексти, посилання й категорії редагуються; вигаданих товарів або обіцянок доставки немає."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Погоджений банер"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Погоджений мобільний банер"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Опис банера для доступності"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Посилання банера"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Меню категорій поруч із банером"
    }
  ],
  "presets": [
    {
      "name": "BAZAR — головний банер"
    }
  ]
}
{% endschema %}

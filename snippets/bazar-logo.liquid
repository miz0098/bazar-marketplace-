{% doc %}
  BAZAR logo mark with blue shopping-bag icon and BAZAR wordmark.

  @param {string} [class] - Additional class name.
{% enddoc %}

<a
  href="{{ routes.root_url }}"
  class="bazar-logo{% if class != blank %} {{ class }}{% endif %}"
  aria-label="BAZAR"
>
  <span
    class="bazar-logo__icon"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 36 36"
      focusable="false"
    >
      <path
        d="M10.5 12.2h15l1.6 17.3H8.9l1.6-17.3Z"
        fill="currentColor"
      />
      <path
        d="M13.8 13.1V11a4.2 4.2 0 0 1 8.4 0v2.1"
        fill="none"
        stroke="#fff"
        stroke-linecap="round"
        stroke-width="2.2"
      />
      <path
        d="M13.7 18.4h8.7"
        fill="none"
        stroke="#fff"
        stroke-linecap="round"
        stroke-width="2.2"
      />
    </svg>
  </span>
  <span class="bazar-logo__text">BAZAR</span>
</a>

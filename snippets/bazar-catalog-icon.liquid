{% doc %}
  Renders a lightweight local SVG icon for BAZAR catalog items.

  @param {string} label - Category or subcategory title.
  @param {number} [variant] - Stable visual variant used to keep icons unique.
{% enddoc %}

{% liquid
  assign icon_label = label | strip
  assign icon_type = 'box'

  case icon_label
    when 'Електроніка'
      assign icon_type = 'devices'
    when 'Побутова техніка'
      assign icon_type = 'washer'
    when "Комп'ютери та офіс"
      assign icon_type = 'office'
    when 'Одяг, взуття та аксесуари'
      assign icon_type = 'fashion'
    when 'Дім та сад'
      assign icon_type = 'home'
    when 'Будівництво та ремонт'
      assign icon_type = 'construction'
    when 'Авто та мото'
      assign icon_type = 'car'
    when 'Спорт та відпочинок'
      assign icon_type = 'sport'
    when "Краса та здоров'я"
      assign icon_type = 'beauty'
    when 'Дитячі товари'
      assign icon_type = 'baby'
    when 'Зоотовари'
      assign icon_type = 'pets'
    when 'Книги'
      assign icon_type = 'book'
    when 'Канцелярія'
      assign icon_type = 'stationery'
    when 'Подарунки'
      assign icon_type = 'gift'
    when 'Смартфони та телефони'
      assign icon_type = 'phone'
    when 'Смартгодинники', 'Годинники'
      assign icon_type = 'watch'
    when 'Планшети'
      assign icon_type = 'tablet'
    when 'Ноутбуки'
      assign icon_type = 'laptop'
    when "Комп'ютери", 'Настільні ПК'
      assign icon_type = 'desktop'
    when 'Монітори'
      assign icon_type = 'monitor'
    when 'Комплектуючі ПК'
      assign icon_type = 'chip'
    when 'Навушники'
      assign icon_type = 'headphones'
    when 'Аудіотехніка'
      assign icon_type = 'speaker'
    when 'Телевізори'
      assign icon_type = 'tv'
    when 'Проєктори'
      assign icon_type = 'projector'
    when 'Фото та відео'
      assign icon_type = 'camera'
    when 'Ігрові приставки'
      assign icon_type = 'gamepad'
    when 'Мережеве обладнання'
      assign icon_type = 'router'
    when 'Принтери та МФУ', 'Принтери'
      assign icon_type = 'printer'
    when 'Накопичувачі'
      assign icon_type = 'drive'
    when 'Кабелі та перехідники'
      assign icon_type = 'cable'
    when 'Зарядні пристрої'
      assign icon_type = 'charger'
    when 'Power Bank'
      assign icon_type = 'powerbank'
    when 'Аксесуари'
      assign icon_type = 'phone-case'
    when 'Автоаксесуари'
      assign icon_type = 'car-accessory'
    when 'Мотоаксесуари'
      assign icon_type = 'helmet'
    when 'Холодильники'
      assign icon_type = 'fridge'
    when 'Пральні машини'
      assign icon_type = 'washer'
    when 'Посудомийні машини'
      assign icon_type = 'dishwasher'
    when 'Варильні поверхні'
      assign icon_type = 'cooktop'
    when 'Духові шафи'
      assign icon_type = 'oven'
    when 'Витяжки'
      assign icon_type = 'hood'
    when 'Мікрохвильові печі'
      assign icon_type = 'microwave'
    when 'Пилососи'
      assign icon_type = 'vacuum'
    when 'Праски'
      assign icon_type = 'iron'
    when 'Кондиціонери'
      assign icon_type = 'snowflake'
    when 'Обігрівачі'
      assign icon_type = 'heater'
    when 'Кавоварки'
      assign icon_type = 'coffee'
    when 'Чайники'
      assign icon_type = 'kettle'
    when 'Мультиварки'
      assign icon_type = 'pot'
    when 'Блендери'
      assign icon_type = 'blender'
    when 'Клавіатури'
      assign icon_type = 'keyboard'
    when 'Миші'
      assign icon_type = 'mouse'
    when 'Вебкамери'
      assign icon_type = 'webcam'
    when 'Сканери'
      assign icon_type = 'scanner'
    when 'UPS'
      assign icon_type = 'ups'
    when 'Сервери'
      assign icon_type = 'server'
    when 'Офісна техніка', 'Офісне приладдя'

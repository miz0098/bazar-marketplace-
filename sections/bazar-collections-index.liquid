{{ 'bazar-collections-index.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'bazar-collections-index.js' | asset_url }}"
  type="module"
></script>

{% capture catalog_tree_data %}
  {% render 'bazar-catalog-data' %}
{% endcapture %}

{% liquid
  assign category_items = catalog_tree_data | strip | split: '||'
%}

<section class="bazar-collections-index" aria-labelledby="BazarCollectionsIndexTitle-{{ section.id }}">
  <div class="bazar-container">
    <header class="bazar-collections-index__header">
      <h1 id="BazarCollectionsIndexTitle-{{ section.id }}" class="bazar-collections-index__title">Категорії</h1>
    </header>

    <ul class="bazar-collections-index__grid" role="list">
      {% for item in category_items %}
        {% liquid
          assign category_record = item | strip
          assign category_parts = category_record | split: '::'
          assign category_title = category_parts[0] | strip
          assign subcategories_data = category_parts[1] | strip
          assign subcategories = subcategories_data | split: '|'
          assign subcategory_count = subcategories.size
          assign subcategory_panel_class = ''

          if subcategory_count > 10
            assign subcategory_panel_class = ' bazar-collections-index__subcategories--three-columns'
          endif
        %}
        <li class="bazar-collections-index__item" data-category-title="{{ category_title | escape }}">
          <a
            class="bazar-collections-index__card"
            href="{%- render 'bazar-collection-url', title: category_title -%}"
          >
            <span class="bazar-collections-index__image" aria-hidden="true">
              {% render 'bazar-catalog-icon', label: category_title, variant: forloop.index %}
            </span>
            <span class="bazar-collections-index__name">{{ category_title }}</span>
          </a>

          {% if subcategories_data != blank %}
            <div
              id="BazarCollectionsSubcategories-{{ section.id }}-{{ forloop.index }}"
              class="bazar-collections-index__subcategories{{ subcategory_panel_class }}"
              aria-label="Підкатегорії {{ category_title | escape }}"
              data-subcategory-count="{{ subcategory_count }}"
            >
              <ul class="bazar-collections-index__subcategory-list" role="list">
                {% assign category_index = forloop.index %}
                {% for subcategory in subcategories %}
                  {% liquid
                    assign subcategory_title = subcategory | strip
                    assign icon_variant = category_index | times: 30 | plus: forloop.index
                  %}
                  <li>
                    <a
                      class="bazar-collections-index__subcategory-link"
                      href="{%- render 'bazar-collection-url', title: subcategory_title -%}"
                    >
                      <span class="bazar-collections-index__subcategory-icon" aria-hidden="true">
                        {% render 'bazar-catalog-icon', label: subcategory_title, variant: icon_variant %}
                      </span>
                      <span>{{ subcategory_title }}</span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "BAZAR Категорії",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [],
  "presets": [
    {
      "name": "BAZAR Категорії"
    }
  ]
}
{% endschema %}

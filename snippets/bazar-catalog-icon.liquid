    when 'Жіночий одяг'
      assign icon_type = 'dress'
    when 'Чоловічий одяг', 'Спортивний одяг', 'Одяг'
      assign icon_type = 'shirt'
    when 'Дитячий одяг'
      assign icon_type = 'kids-shirt'
    when 'Взуття'
      assign icon_type = 'shoe'
    when 'Сумки'
      assign icon_type = 'bag'
    when 'Рюкзаки'
      assign icon_type = 'backpack'
    when 'Гаманці'
      assign icon_type = 'wallet'
    when 'Головні убори'
      assign icon_type = 'hat'
    when 'Білизна'
      assign icon_type = 'textile'
    when 'Прикраси'
      assign icon_type = 'jewelry'
    when 'Меблі', 'Садові меблі'
      assign icon_type = 'sofa'
    when 'Освітлення'
      assign icon_type = 'lamp'
    when 'Декор', 'Сувеніри'
      assign icon_type = 'decor'
    when 'Текстиль'
      assign icon_type = 'textile'
    when 'Посуд'
      assign icon_type = 'dishes'
    when 'Кухонне приладдя'
      assign icon_type = 'kitchenware'
    when 'Побутова хімія', 'Автохімія'
      assign icon_type = 'bottle'
    when 'Садова техніка'
      assign icon_type = 'mower'
    when 'Рослини'
      assign icon_type = 'plant'
    when 'Електроінструмент'
      assign icon_type = 'drill'
    when 'Ручний інструмент'
      assign icon_type = 'hand-tool'
    when 'Будівельні матеріали'
      assign icon_type = 'bricks'
    when 'Лакофарбові матеріали'
      assign icon_type = 'paint'
    when 'Сантехніка'
      assign icon_type = 'plumbing'
    when 'Електрика'
      assign icon_type = 'bolt'
    when 'Кріплення'
      assign icon_type = 'screw'
    when 'Драбини'
      assign icon_type = 'ladder'
    when 'Автозапчастини'
      assign icon_type = 'gear'
    when 'Шини'
      assign icon_type = 'tire'
    when 'Диски'
      assign icon_type = 'wheel'
    when 'Акумулятори'
      assign icon_type = 'battery'
    when 'Мастила'
      assign icon_type = 'oil'
    when 'Відеореєстратори'
      assign icon_type = 'dashcam'
    when 'Компресори'
      assign icon_type = 'compressor'
    when 'Велосипеди'
      assign icon_type = 'bike'
    when 'Самокати'
      assign icon_type = 'scooter'
    when 'Тренажери'
      assign icon_type = 'trainer'
    when 'Фітнес'
      assign icon_type = 'dumbbell'
    when 'Туризм', 'Кемпінг'
      assign icon_type = 'tent'
    when 'Риболовля'
      assign icon_type = 'fish'
    when 'Полювання'
      assign icon_type = 'binoculars'
    when "М'ячі"
      assign icon_type = 'ball'
    when 'Косметика'
      assign icon_type = 'cosmetics'
    when 'Парфуми'
      assign icon_type = 'perfume'
    when 'Догляд за обличчям'
      assign icon_type = 'face'
    when 'Догляд за тілом'
      assign icon_type = 'body'
    when 'Догляд за волоссям'
      assign icon_type = 'hair'
    when 'Гоління'
      assign icon_type = 'razor'
    when 'Медичні товари'
      assign icon_type = 'medical'
    when 'Вітаміни'
      assign icon_type = 'vitamin'
    when 'Масажери'
      assign icon_type = 'massager'
    when 'Іграшки'
      assign icon_type = 'toy'
    when 'Конструктори'
      assign icon_type = 'blocks'
    when 'Візочки'
      assign icon_type = 'stroller'
    when 'Автокрісла'
      assign icon_type = 'carseat'
    when 'Підгузки'
      assign icon_type = 'diaper'
    when 'Харчування'
      assign icon_type = 'baby-food'
    when 'Шкільне приладдя'
      assign icon_type = 'school'
    when 'Корм для собак'
      assign icon_type = 'dog'
    when 'Корм для котів'
      assign icon_type = 'cat'
    when 'Лежанки'
      assign icon_type = 'bed'
    when 'Переноски'
      assign icon_type = 'carrier'
    when 'Акваріуми'
      assign icon_type = 'aquarium'
    when 'Товари для гризунів'
      assign icon_type = 'hamster'
    when 'Товари для птахів'
      assign icon_type = 'bird-cage'
    when 'Художня література'
      assign icon_type = 'book'
    when 'Бізнес'
      assign icon_type = 'book'
    when 'Саморозвиток'
      assign icon_type = 'book'
    when 'Навчальна література'
      assign icon_type = 'book'
    when 'Дитячі книги'
      assign icon_type = 'book'
    when 'Комікси'
      assign icon_type = 'book'
    when 'Папір'
      assign icon_type = 'paper'
    when 'Ручки'
      assign icon_type = 'pen'
    when 'Олівці'
      assign icon_type = 'pencil'
    when 'Щоденники'
      assign icon_type = 'diary'
    when 'Зошити'
      assign icon_type = 'notebook'
    when 'Папки'
      assign icon_type = 'folder'
    when 'Подарункові набори'
      assign icon_type = 'gift'
    when 'Сертифікати'
      assign icon_type = 'certificate'
    when 'Святковий декор'
      assign icon_type = 'party'
    when 'Листівки'
      assign icon_type = 'postcard'
  endcase

  assign icon_variant = variant | default: 1 | plus: 0
  assign accent_slot = icon_variant | modulo: 4

  case accent_slot
    when 0
      assign accent_x = 47
      assign accent_y = 16
    when 1
      assign accent_x = 49
      assign accent_y = 47
    when 2
      assign accent_x = 16
      assign accent_y = 49
    else
      assign accent_x = 16
      assign accent_y = 16
  endcase
%}

<svg
  class="bazar-catalog-icon"
  viewBox="0 0 64 64"
  role="img"
  focusable="false"
  aria-label="{{ icon_label | escape }}"
>
  <rect
    x="3"
    y="3"
    width="58"
    height="58"
    rx="18"
    fill="#eff6ff"
  />
  <rect
    x="3.5"
    y="3.5"
    width="57"
    height="57"
    rx="17.5"
    fill="none"
    stroke="#d8e8ff"
  />
  <circle
    cx="{{ accent_x }}"
    cy="{{ accent_y }}"
    r="4"
    fill="#1173f5"
    opacity=".18"
  />

  <g
    class="bazar-catalog-icon__glyph"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="3"
  >
    {% case icon_type %}
      {% when 'devices' %}
        <rect x="15" y="23" width="22" height="17" rx="3" />
        <rect x="40" y="17" width="10" height="28" rx="3" />
        <path d="M25 40v7M19 47h13M43 40h4" />
      {% when 'office' %}
        <rect x="16" y="22" width="32" height="25" rx="5" />
        <path d="M25 22v-6h14v6M23 32h18M23 39h12" />
      {% when 'fashion' %}
        <path d="M23 17 16 24l5 6 3-3v20h16V27l3 3 5-6-7-7-4 4H27l-4-4Z" />
        <path d="M43 38h8v10h-8z" />
      {% when 'home' %}
        <path d="M14 31 32 16l18 15" />
        <path d="M20 30v20h24V30M28 50V38h8v12" />
      {% when 'sport' %}
        <circle cx="26" cy="34" r="11" />
        <path d="M40 23h6M43 20v6M37 40l10 10" />
      {% when 'accessory' %}
        <path d="M18 20h20l10 10-24 24-10-10 24-24" />
        <circle cx="32" cy="26" r="3" />
      {% when 'phone-case' %}
        <rect x="21" y="13" width="22" height="38" rx="7" />
        <rect x="26" y="19" width="12" height="24" rx="3" />
        <circle cx="36" cy="18" r="2" />
        <path d="M29 48h6" />
      {% when 'phone' %}
        <rect x="23" y="13" width="18" height="38" rx="5" />
        <path d="M29 45h6" />
      {% when 'watch' %}
        <rect x="22" y="20" width="20" height="24" rx="7" />
        <path d="M26 20v-7h12v7M26 44v7h12v-7" />
      {% when 'tablet' %}
        <rect x="18" y="12" width="28" height="40" rx="6" />
        <path d="M29 46h6" />
      {% when 'laptop' %}
        <path d="M17 19h30v20H17zM12 45h40l-5-6H17l-5 6Z" />
      {% when 'desktop' %}
        <rect x="16" y="16" width="32" height="23" rx="3" />
        <path d="M32 39v8M24 47h16" />
      {% when 'monitor' %}
        <rect x="13" y="17" width="38" height="24" rx="3" />
        <path d="M32 41v7M24 48h16" />
      {% when 'chip' %}
        <rect x="22" y="22" width="20" height="20" rx="3" />
        <path d="M18 25h4M18 32h4M18 39h4M42 25h4M42 32h4M42 39h4M25 18v4M32 18v4M39 18v4M25 42v4M32 42v4M39 42v4" />
      {% when 'headphones' %}

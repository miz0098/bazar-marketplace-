{% assign count = 0 %}{% for block in section.blocks %}{% if block.settings.image != blank and block.settings.link != blank and block.settings.name != blank %}{% assign count = count | plus: 1 %}{% endif %}{% endfor %}
{% if count > 0 %}<div class="bazar-ui bazar-home"><div class="bazar-container">
{% if section.settings.heading != blank %}<h2 class="bazar-home__title">{{ section.settings.heading | escape }}</h2>{% endif %}
<ul class="bazar-home-brands" role="list">{% for block in section.blocks %}{% if block.settings.image != blank and block.settings.link != blank and block.settings.name != blank %}<li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.image | image_url: width: 320 | image_tag: alt: block.settings.name, loading: 'lazy' }}</a></li>{% endif %}{% endfor %}</ul>
</div></div>{% elsif request.design_mode %}<p class="bazar-ui bazar-container bazar-editor-note">Додайте погоджені логотипи, справжні назви брендів та їхні адреси. Неповні записи приховані.</p>{% endif %}
{% schema %}
{
  "name": "BAZAR — бренди",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Заголовок",
      "default": "Популярні бренди"
    }
  ],
  "presets": [
    {
      "name": "BAZAR — бренди"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "brand",
      "name": "Бренд",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Справжній логотип"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Назва бренду для доступності"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Справжня адреса бренду"
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'bazar-auth.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'bazar-auth.js' | asset_url }}"
  defer
></script>

<section class="bazar-auth" aria-labelledby="BazarLoginTitle-{{ section.id }}">
  <div class="bazar-container">
    <div class="bazar-auth__shell">
      <div class="bazar-auth__intro">
        <p class="bazar-auth__eyebrow">BAZAR акаунт</p>
        <h1 id="BazarLoginTitle-{{ section.id }}" class="bazar-auth__title">Увійдіть до BAZAR</h1>
        <p class="bazar-auth__text">
          Керуйте замовленнями, адресами доставки та обраними товарами в одному особистому кабінеті.
        </p>
        <ul class="bazar-auth__benefits" role="list">
          <li class="bazar-auth__benefit">Швидкий доступ до історії замовлень</li>
          <li class="bazar-auth__benefit">Збережені адреси доставки</li>
          <li class="bazar-auth__benefit">Персональний список обраного</li>
        </ul>
      </div>

      <div
        class="bazar-auth-card"
        data-bazar-auth-login-card
      >
        <p class="bazar-auth-card__eyebrow">Вхід</p>
        <h2 class="bazar-auth-card__title">Особистий кабінет</h2>
        <p class="bazar-auth-card__text">Введіть email і пароль, щоб продовжити.</p>

        {% form 'customer_login', class: 'bazar-auth-form', novalidate: 'novalidate' %}
          {% render 'bazar-auth-form-errors', form: form %}

          {% render 'bazar-auth-field',
            id: 'BazarLoginEmail',
            label: 'Електронна пошта',
            name: 'customer[email]',
            type: 'email',
            autocomplete: 'email',
            required: true,
            data_role: 'email'
          %}

          {% render 'bazar-auth-field',
            id: 'BazarLoginPassword',
            label: 'Пароль',
            name: 'customer[password]',
            type: 'password',
            autocomplete: 'current-password',
            required: true
          %}

          <label class="bazar-auth-checkbox">
            <input
              class="bazar-auth-checkbox__input"
              type="checkbox"
              name="remember_me"
              value="1"
            >
            <span class="bazar-auth-checkbox__label">Запам'ятати мене</span>
          </label>

          <div class="bazar-auth-form__actions">
            <button class="bazar-auth-button" type="submit">Увійти</button>
            <a
              class="bazar-auth-link"
              href="#recover"
              data-bazar-auth-recover-toggle
            >
              Забули пароль?
            </a>
          </div>

          <p class="bazar-auth-card__text">
            Немає акаунта?
            <a class="bazar-auth-link" href="{{ routes.account_register_url }}">Створити акаунт</a>
          </p>
        {% endform %}
      </div>

      <div
        class="bazar-auth-card"
        data-bazar-auth-recover-card
        hidden
      >
        <p class="bazar-auth-card__eyebrow">Відновлення</p>
        <h2 class="bazar-auth-card__title">Забули пароль?</h2>
        <p class="bazar-auth-card__text">Вкажіть електронну пошту, і ми надішлемо посилання для відновлення доступу.</p>

        {% form 'recover_customer_password', class: 'bazar-auth-form', novalidate: 'novalidate' %}
          {% render 'bazar-auth-form-errors', form: form %}

          {% if form.posted_successfully? %}
            <div class="bazar-auth-alert bazar-auth-alert--success" role="status">
              <p class="bazar-auth-alert__title">Посилання надіслано</p>
              <p class="bazar-auth-card__text">Перевірте пошту та відкрийте лист від BAZAR.</p>
            </div>
          {% endif %}

          {% render 'bazar-auth-field',
            id: 'BazarRecoverEmail',
            label: 'Електронна пошта',
            name: 'email',
            type: 'email',
            autocomplete: 'email',
            required: true,
            data_role: 'email'
          %}

          <div class="bazar-auth-form__actions">
            <button class="bazar-auth-button" type="submit">Надіслати посилання</button>
            <a
              class="bazar-auth-link"
              href="{{ routes.account_login_url }}"
              data-bazar-auth-login-toggle
            >
              Повернутися до входу
            </a>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BAZAR Вхід",
  "enabled_on": {
    "templates": ["customers/login"]
  },
  "settings": [],
  "presets": [
    {
      "name": "BAZAR Вхід"
    }
  ]
}
{% endschema %}

{
  "name": "@bazar/storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "browser:build": "BAZAR_BROWSER_INTEGRATION=1 next build browser-integration",
    "typecheck:browser": "tsc --noEmit -p browser-integration/tsconfig.json",
    "storefront:build": "BAZAR_BROWSER_INTEGRATION=1 BAZAR_STOREFRONT_INTEGRATION=1 next build storefront-integration",
    "typecheck:storefront": "tsc --noEmit -p storefront-integration/tsconfig.json"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

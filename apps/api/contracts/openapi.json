                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "getVersionHeaders",
        "responses": {
          "200": {
            "description": "Same status and headers as GET, without a response body"
          },
          "default": {
            "description": "Same error status/headers as GET, without a body"
          }
        }
      },
      "options": {
        "operationId": "getVersionPreflight",
        "description": "Requires an exact allow-listed Origin and Access-Control-Request-Method GET or HEAD. Only Content-Type is allowed in requested headers. No credentials.",
        "responses": {
          "204": {
            "description": "Validated CORS preflight; no response body"
          },
          "default": {
            "description": "JSON envelope; HEAD has matching headers and no body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "ok"
              },
              "scope": {
                "const": "process"
              },
              "uptimeSeconds": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "status",
              "scope",
              "uptimeSeconds"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "requestId"
            ]
          }
        },
        "required": [
          "ok",
          "data",
          "meta"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "ready"
              },
              "dependencies": {
                "type": "array",
                "maxItems": 1,
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "status"
                  ],
                  "properties": {
                    "name": {
                      "const": "postgresql"
                    },
                    "status": {
                      "const": "ready"
                    }
                  }
                }
              },
              "businessModulesAvailable": {
                "const": false
              }
            },
            "required": [
              "status",
              "dependencies",
              "businessModulesAvailable"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "requestId"
            ]
          }
        },
        "required": [
          "ok",
          "data",
          "meta"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service": {
                "const": "bazar-api"
              },
              "apiVersion": {
                "const": "v1"
              },
              "businessModulesAvailable": {
                "const": false
              }
            },
            "required": [
              "service",
              "apiVersion",
              "businessModulesAvailable"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "requestId"
            ]
          }
        },
        "required": [
          "ok",
          "data",
          "meta"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "CORS_DENIED",
                  "METHOD_NOT_ALLOWED",
                  "NOT_FOUND",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE",
                  "HEADERS_TOO_LARGE"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "requestId"
            ]
          }
        },
        "required": [
          "ok",
          "error",
          "meta"
        ]
      },
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "const": "UAH"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ]
      },
      "PageInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "limit"
        ]
      }
    }
  },

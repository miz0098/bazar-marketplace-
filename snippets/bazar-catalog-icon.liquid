        <path d="M24 21h16M29 17h6M13 31h4M47 31h4" />
      {% when 'blender' %}
        <path d="M23 14h18l-3 23H26l-3-23Z" />
        <path d="M27 37h10l4 13H23l4-13Z" />
      {% when 'keyboard' %}

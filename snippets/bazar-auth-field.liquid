{% doc %}
  Reusable BAZAR authentication field.

  @param {string} id
  @param {string} label
  @param {string} name
  @param {string} [type]
  @param {string} [value]
  @param {string} [autocomplete]
  @param {string} [placeholder]
  @param {boolean} [required]
  @param {string} [minlength]
  @param {string} [describedby]
  @param {string} [data_role]
{% enddoc %}

{% liquid
  assign field_type = type | default: 'text'
  assign describedby_value = describedby | default: ''

  if describedby_value != blank
    assign describedby_value = describedby_value | append: ' ' | append: id | append: '-error'
  else
    assign describedby_value = id | append: '-error'
  endif
%}

<div class="bazar-auth-field" data-bazar-auth-field>
  <label
    class="bazar-auth-field__label"
    for="{{ id }}"
  >
    {{ label }}
  </label>

  <input
    id="{{ id }}"
    class="bazar-auth-field__input"
    type="{{ field_type }}"
    name="{{ name }}"
    value="{{ value | escape }}"
    aria-describedby="{{ describedby_value | strip }}"
    {% if autocomplete != blank %}
      autocomplete="{{ autocomplete }}"
    {% endif %}
    {% if placeholder != blank %}
      placeholder="{{ placeholder }}"
    {% endif %}
    {% if required %}
      required
      aria-required="true"
    {% endif %}
    {% if minlength != blank %}
      minlength="{{ minlength }}"
    {% endif %}
    {% if data_role == 'email' %}
      data-bazar-email
    {% elsif data_role == 'password' %}
      data-bazar-password
    {% elsif data_role == 'password-confirm' %}
      data-bazar-password-confirm
    {% endif %}
  >

  <span
    id="{{ id }}-error"
    class="bazar-auth-field__error"
    data-bazar-field-error
    aria-live="polite"
  ></span>
</div>

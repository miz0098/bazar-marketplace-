{% doc %}
  BAZAR desktop catalog dropdown.

  @param {section} section - Header section object.
{% enddoc %}

{% capture catalog_tree_data %}
  {% render 'bazar-catalog-data' %}
{% endcapture %}

{% liquid
  assign catalog_categories = catalog_tree_data | strip | split: '||'
%}

<div
  class="bazar-header__catalog-wrap"
  data-bazar-catalog
>
  <button
    type="button"
    class="bazar-header__catalog"
    aria-label="Відкрити каталог"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="BazarCatalogMenu-{{ section.id }}"
    data-bazar-catalog-trigger
  >
    <span
      class="bazar-header__catalog-icon"
      aria-hidden="true"
    ></span>
    <span>Каталог</span>
  </button>

  <div
    id="BazarCatalogMenu-{{ section.id }}"
    class="bazar-catalog-menu"
    role="dialog"
    aria-label="Каталог товарів"
    aria-modal="false"
    data-bazar-catalog-panel
    hidden
  >
    <div class="bazar-catalog-menu__content">
      <div class="bazar-catalog-menu__main">
        {% if catalog_categories.size > 0 %}
          <ul
            class="bazar-catalog-menu__categories"
            role="tablist"
            aria-label="Основні категорії каталогу"
            aria-orientation="vertical"
          >
            {% for category_item in catalog_categories %}
              {% liquid
                assign category_record = category_item | strip
                assign category_parts = category_record | split: '::'
                assign category_title = category_parts[0] | strip
              %}
              {% capture category_id %}BazarCatalogCategory-{{ section.id }}-{{ forloop.index }}{% endcapture %}
              {% capture panel_id %}BazarCatalogPanel-{{ section.id }}-{{ forloop.index }}{% endcapture %}
              <li role="presentation">
                <a
                  href="{%- render 'bazar-collection-url', title: category_title -%}"
                  id="{{ category_id }}"
                  class="bazar-catalog-menu__category-link{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  data-bazar-catalog-category
                  data-bazar-catalog-target="{{ panel_id }}"
                  aria-controls="{{ panel_id }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  {% if forloop.first %}
                  aria-current="true"
                  {% endif %}
                >
                  <span
                    class="bazar-catalog-menu__category-icon"
                    aria-hidden="true"
                  >
                    {% render 'bazar-catalog-icon', label: category_title, variant: forloop.index %}
                  </span>
                  <span class="bazar-catalog-menu__category-title">{{ category_title }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="bazar-catalog-menu__empty">Категорії ще не налаштовано.</p>
        {% endif %}
      </div>

      <div class="bazar-catalog-menu__subcategories">
        {% if catalog_categories.size > 0 %}
          {% for category_item in catalog_categories %}
            {% liquid
              assign category_record = category_item | strip
              assign category_parts = category_record | split: '::'
              assign category_title = category_parts[0] | strip
              assign subcategories_data = category_parts[1] | strip
              assign subcategories = subcategories_data | split: '|'
            %}
            {% capture category_id %}BazarCatalogCategory-{{ section.id }}-{{ forloop.index }}{% endcapture %}
            {% capture panel_id %}BazarCatalogPanel-{{ section.id }}-{{ forloop.index }}{% endcapture %}
            <div
              id="{{ panel_id }}"
              class="bazar-catalog-menu__panel{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="{{ category_id }}"
              data-bazar-catalog-subpanel
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              <div class="bazar-catalog-menu__panel-header">
                <h2 class="bazar-catalog-menu__panel-title">{{ category_title }}</h2>
              </div>

              {% if subcategories_data != blank %}
                <ul
                  class="bazar-catalog-menu__subcategory-grid"
                  role="list"
                >
                  {% assign category_index = forloop.index %}
                  {% for subcategory in subcategories %}
                    {% liquid
                      assign subcategory_title = subcategory | strip
                      assign icon_variant = category_index | times: 30 | plus: forloop.index
                    %}
                    <li class="bazar-catalog-menu__subcategory">
                      <a
                        class="bazar-catalog-menu__subcategory-link"
                        href="{%- render 'bazar-collection-url', title: subcategory_title -%}"
                      >
                        <span
                          class="bazar-catalog-menu__subcategory-icon"
                          aria-hidden="true"
                        >
                          {% render 'bazar-catalog-icon', label: subcategory_title, variant: icon_variant %}
                        </span>
                        <span class="bazar-catalog-menu__subcategory-title">{{ subcategory_title }}</span>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <p class="bazar-catalog-menu__empty">Підкатегорії ще не налаштовано.</p>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <p class="bazar-catalog-menu__empty">Категорії ще не налаштовано.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

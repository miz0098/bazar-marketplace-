{
  "name": "@bazar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env.local dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:production": "node --import tsx --test tests/production.test.mjs",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0"
  }
}

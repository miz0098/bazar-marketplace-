{{ 'bazar-auth.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'bazar-auth.js' | asset_url }}"
  defer
></script>

<section class="bazar-auth" aria-labelledby="BazarResetTitle-{{ section.id }}">
  <div class="bazar-container">
    <div class="bazar-auth__shell">
      <div class="bazar-auth__intro">
        <p class="bazar-auth__eyebrow">Безпека</p>
        <h1 id="BazarResetTitle-{{ section.id }}" class="bazar-auth__title">Оновіть пароль</h1>
        <p class="bazar-auth__text">
          Створіть новий пароль для акаунта BAZAR. Після збереження можна буде увійти з оновленими даними.
        </p>
      </div>

      <div class="bazar-auth-card">
        <p class="bazar-auth-card__eyebrow">Новий пароль</p>
        <h2 class="bazar-auth-card__title">Скидання пароля</h2>

        {% form 'reset_customer_password', class: 'bazar-auth-form', novalidate: 'novalidate' %}
          {% render 'bazar-auth-form-errors', form: form %}

          {% render 'bazar-auth-field',
            id: 'BazarResetPassword',
            label: 'Пароль',
            name: 'customer[password]',
            type: 'password',
            autocomplete: 'new-password',
            required: true,
            minlength: '8',
            describedby: 'BazarResetPasswordStrengthLabel',
            data_role: 'password'
          %}

          <div
            class="bazar-auth-password-strength"
            data-bazar-password-strength
            data-strength="empty"
            aria-live="polite"
          >
            <div class="bazar-auth-password-strength__track" aria-hidden="true">
              <span class="bazar-auth-password-strength__bar"></span>
              <span class="bazar-auth-password-strength__bar"></span>
              <span class="bazar-auth-password-strength__bar"></span>
            </div>
            <span
              id="BazarResetPasswordStrengthLabel"
              class="bazar-auth-password-strength__label"
              data-bazar-password-strength-label
            >
              Надійність пароля
            </span>
          </div>

          {% render 'bazar-auth-field',
            id: 'BazarResetPasswordConfirm',
            label: 'Підтвердження пароля',
            name: 'customer[password_confirmation]',
            type: 'password',
            autocomplete: 'new-password',
            required: true,
            data_role: 'password-confirm'
          %}

          <div class="bazar-auth-form__actions">
            <button class="bazar-auth-button" type="submit">Зберегти пароль</button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BAZAR Скидання пароля",
  "enabled_on": {
    "templates": ["customers/reset_password"]
  },
  "settings": [],
  "presets": [
    {
      "name": "BAZAR Скидання пароля"
    }
  ]
}
{% endschema %}
